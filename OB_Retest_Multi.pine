    last_s1_30 := newL3
    anyRetest := anyRetest or fired3
    if str.length(msg3) > 0
        alertMsg := str.length(alertMsg) > 0 ? alertMsg + " | " + msg3 : msg3
    [fired4, newL4, msg4] = f_take(en1, enTf60, s1_60, e1_60, sl1_60, tp1_60, sym1, "60", last_s1_60)
