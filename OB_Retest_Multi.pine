var int last_s1_5 = 0
var int last_s1_15 = 0
var int last_s1_30 = 0
var int last_s1_60 = 0
var int last_s1_240 = 0
var int last_s1_D = 0
var int last_s2_5 = 0
var int last_s2_15 = 0
var int last_s2_30 = 0
var int last_s2_60 = 0
var int last_s2_240 = 0
var int last_s2_D = 0
var int last_s3_5 = 0
var int last_s3_15 = 0
var int last_s3_30 = 0
var int last_s3_60 = 0
var int last_s3_240 = 0
var int last_s3_D = 0
var int last_s4_5 = 0
var int last_s4_15 = 0
var int last_s4_30 = 0
var int last_s4_60 = 0
var int last_s4_240 = 0
var int last_s4_D = 0
var int last_s5_5 = 0
var int last_s5_15 = 0
var int last_s5_30 = 0
var int last_s5_60 = 0
var int last_s5_240 = 0
var int last_s5_D = 0
var int last_s6_5 = 0
var int last_s6_15 = 0
var int last_s6_30 = 0
var int last_s6_60 = 0
var int last_s6_240 = 0
var int last_s6_D = 0

f_fireId(int enc) =>
    enc == 0 ? 0 : int(math.abs(enc) / 10)

f_stars(int enc) =>
    enc == 0 ? 0 : int(math.abs(enc) % 10)

f_sideTxt(int enc) =>
    enc > 0 ? "Bull" : "Bear"

f_short(string full) =>
    int p = str.pos(full, ":")
    na(p) ? full : str.substring(full, p + 1)

// Append fragment if new retest; update lastId; return [anyFired, newLast, msg]
f_take(bool enS, bool enT, int enc, float entryPx, float slPx, float tpPx, string sy, string tf, int lastId) =>
    bool fired = false
    int newLast = lastId
    string msg = ""
    int fid = f_fireId(enc)
    if enS and enT and barstate.isconfirmed and enc != 0 and fid != 0 and fid != lastId
        fired := true
        newLast := fid
        msg := "Retest " + f_sideTxt(enc) + " " + f_short(sy) + " " + tf + " " + str.tostring(f_stars(enc)) + "*"
        if not na(slPx) and not na(tpPx)
            msg := msg + " SL=" + str.tostring(slPx, format.mintick) + " TP=" + str.tostring(tpPx, format.mintick)
    [fired, newLast, msg]

bool anyRetest = false

if barstate.isconfirmed
    string alertMsg = ""
    [fired1, newL1, msg1] = f_take(en1, enTf5, s1_5, e1_5, sl1_5, tp1_5, sym1, "5", last_s1_5)
    last_s1_5 := newL1
    anyRetest := anyRetest or fired1
    if str.length(msg1) > 0
        alertMsg := str.length(alertMsg) > 0 ? alertMsg + " | " + msg1 : msg1
    [fired2, newL2, msg2] = f_take(en1, enTf15, s1_15, e1_15, sl1_15, tp1_15, sym1, "15", last_s1_15)
    last_s1_15 := newL2
    anyRetest := anyRetest or fired2
    if str.length(msg2) > 0
