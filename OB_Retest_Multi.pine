[s5_5, e5_5, sl5_5, tp5_5] = request.security(sym5, "5", f_retestSignal(), barmerge.gaps_off, barmerge.lookahead_off)
[s5_15, e5_15, sl5_15, tp5_15] = request.security(sym5, "15", f_retestSignal(), barmerge.gaps_off, barmerge.lookahead_off)
[s5_30, e5_30, sl5_30, tp5_30] = request.security(sym5, "30", f_retestSignal(), barmerge.gaps_off, barmerge.lookahead_off)
