//@version=6
// OB Retest Multi - retest-only alerts across watchlist x timeframes.
// alert() ONLY on first touch of a fresh OB (stars >= minStars). NOT on OB creation.
// Not financial advice. Set exact broker tickers in Inputs.
indicator("OB Retest Multi", overlay = false, max_bars_back = 500)

minStars      = input.int(4, "Min stars", minval = 0, maxval = 5, group = "Scoring")
bodyLookback  = input.int(20, "Body lookback", minval = 5, group = "Scoring")
bodyMult      = input.float(1.5, "Body mult", minval = 0.5, step = 0.1, group = "Scoring")
breakLookback = input.int(10, "Break lookback", minval = 3, group = "Scoring")
obWalkback    = input.int(8, "OB walkback", minval = 1, maxval = 20, group = "Scoring")
bosLookback   = input.int(20, "BOS lookback", minval = 5, group = "Scoring")
maxActive     = input.int(12, "Max active OBs per context", minval = 1, maxval = 40, group = "Scoring")
enableAlerts  = input.bool(true, "Fire alert() on retest", group = "Scoring")

gSym = "Symbols"
sym1 = input.symbol("XAUUSD", "1 XAUUSD", group = gSym)
en1  = input.bool(true, "On##1", group = gSym)
sym2 = input.symbol("NAS100", "2 NAS100", group = gSym)
en2  = input.bool(true, "On##2", group = gSym)
sym3 = input.symbol("US500", "3 S&P 500 cash", group = gSym)
en3  = input.bool(true, "On##3", group = gSym)
sym4 = input.symbol("BTCUSD", "4 BTCUSD", group = gSym)
en4  = input.bool(true, "On##4", group = gSym)
sym5 = input.symbol("EURUSD", "5 EURUSD", group = gSym)
en5  = input.bool(true, "On##5", group = gSym)
sym6 = input.symbol("GBPUSD", "6 GBPUSD", group = gSym)
en6  = input.bool(true, "On##6", group = gSym)

gTf = "Timeframes"
enTf5   = input.bool(true, "5m", group = gTf)
enTf15  = input.bool(true, "15m", group = gTf)
enTf30  = input.bool(true, "30m", group = gTf)
enTf60  = input.bool(true, "60m", group = gTf)
enTf240 = input.bool(true, "240m", group = gTf)
enTfD   = input.bool(true, "D", group = gTf)

type ObLite
    int obBar
    int dispBar
    int side
    float hi
    float lo
    float mid
    int stars
    bool mitigated
    bool alertedRetest

f_body(int off) =>
    math.abs(close[off] - open[off])

f_scoreFvg(int dOff, bool bullish) =>
    bool hit = false
    if dOff >= 1
        if bullish and low[dOff - 1] > high[dOff + 1]
            hit := true
        if not bullish and high[dOff - 1] < low[dOff + 1]
            hit := true
    if not hit and bar_index >= dOff + 2
        if bullish and low[dOff] > high[dOff + 2]
            hit := true
        if not bullish and high[dOff] < low[dOff + 2]
            hit := true
    if not hit
        for a = 1 to 3
            ao = dOff - a
            if ao >= 0
                if bullish and low[ao] > high[dOff]
                    hit := true
                if not bullish and high[ao] < low[dOff]
                    hit := true
    hit

f_scoreBos(int dOff, bool bullish) =>
    float ph = ta.highest(high[dOff + 1], bosLookback)
    float pl = ta.lowest(low[dOff + 1], bosLookback)
    bullish ? close[dOff] > ph : close[dOff] < pl

f_scoreSweep(int dOff, bool bullish) =>
    bool ok = false
    if bar_index - dOff >= 15
        if bullish
            ok := ta.lowest(low[dOff], 6) < ta.lowest(low[dOff + 6], 10)
        else
            ok := ta.highest(high[dOff], 6) > ta.highest(high[dOff + 6], 10)
    ok

f_scorePd(int dOff, int obOff, float midPx, bool bullish) =>
    float swingLow = ta.lowest(low[dOff + 1], 50)
    int endOff = math.max(0, dOff - 5)
    int len = obOff - endOff + 1
    bool pass = false
    if len > 0
        float swingHigh = ta.highest(high[endOff], len)
        if not na(swingHigh) and swingHigh > swingLow
            float half = swingLow + 0.5 * (swingHigh - swingLow)
            pass := bullish ? midPx <= half : midPx >= half
    pass

f_existsDedup(array<ObLite> obs, int obBar, int side) =>
    bool found = false
    int sz = array.size(obs)
    if sz > 0
        for i = 0 to sz - 1
            ObLite o = array.get(obs, i)
            if o.obBar == obBar and o.side == side
                found := true
                break
    found

// Entry = mid; SL beyond extreme + buffer; TP = 1.5R (mintick from THIS security context)
f_slTp(float hi, float lo, int side) =>
    float entry = (hi + lo) / 2.0
    float rng = math.max(0.0, hi - lo)
    float buf = math.max(rng * 0.05, syminfo.mintick * 2.0)
    float sl = side == 1 ? lo - buf : hi + buf
    float r = math.abs(entry - sl)
    float tp = side == 1 ? entry + 1.5 * r : entry - 1.5 * r
    [entry, sl, tp, r]

// Returns [encoded, entry, sl, tp]
// encoded: 0 = none; else sign(side)*(fireBar*10 + stars)
f_retestSignal() =>
    var array<ObLite> obs = array.new<ObLite>()
    int encoded = 0
    float outEntry = na
    float outSl = na
    float outTp = na

    if barstate.isconfirmed and array.size(obs) > 0
        for i = 0 to array.size(obs) - 1
            ObLite o = array.get(obs, i)
            if not o.mitigated
                if o.side == 1 and close < o.mid
                    o.mitigated := true
                else if o.side == -1 and close > o.mid
                    o.mitigated := true
            if not o.mitigated and o.stars >= minStars and not o.alertedRetest
                if low <= o.hi and high >= o.lo and bar_index > o.dispBar
                    o.alertedRetest := true
                    int starsClamped = math.min(5, math.max(0, o.stars))
                    encoded := o.side * (bar_index * 10 + starsClamped)
                    [e0, s0, t0, r0] = f_slTp(o.hi, o.lo, o.side)
                    outEntry := e0
                    outSl := s0
                    outTp := t0

    bool enoughHistory = bar_index >= bodyLookback + breakLookback + obWalkback + 55
    if barstate.isconfirmed and enoughHistory
        float bodyDisp = f_body(1)
        float sumB = 0.0
        for j = 2 to bodyLookback + 1
            sumB += f_body(j)
        float avgBody = sumB / bodyLookback
        bool strongBody = avgBody > 0 and bodyDisp >= bodyMult * avgBody
        float priorHigh = ta.highest(high[2], breakLookback)
        float priorLow = ta.lowest(low[2], breakLookback)
        bool bullDisp = close[1] > open[1] and (strongBody or close[1] > priorHigh)
        bool bearDisp = close[1] < open[1] and (strongBody or close[1] < priorLow)

        if bullDisp or bearDisp
            bool isBull = bullDisp
            int obOff = na
            for k = 2 to 1 + obWalkback
                if isBull
                    if close[k] < open[k]
                        obOff := k
                        break
                else
                    if close[k] > open[k]
                        obOff := k
                        break
            if not na(obOff)
                int obBarIdx = bar_index - obOff
                int dispBarIdx = bar_index - 1
                int side = isBull ? 1 : -1
                if not f_existsDedup(obs, obBarIdx, side)
                    float obHi = high[obOff]
                    float obLo = low[obOff]
                    float obMid = (obHi + obLo) / 2.0
                    bool flFvg = f_scoreFvg(1, isBull)
                    bool flBos = f_scoreBos(1, isBull)
                    bool flSweep = f_scoreSweep(1, isBull)
                    bool flPd = f_scorePd(1, obOff, obMid, isBull)
                    int stars = (flFvg ? 1 : 0) + (flBos ? 1 : 0) + (flSweep ? 1 : 0) + 1 + (flPd ? 1 : 0)
                    if stars >= minStars
                        ObLite o = ObLite.new(obBarIdx, dispBarIdx, side, obHi, obLo, obMid, stars, false, false)
                        array.push(obs, o)
                        while array.size(obs) > maxActive
                            array.shift(obs)
    [encoded, outEntry, outSl, outTp]

// 36 security pulls (enc, entry, sl, tp)
[s1_5, e1_5, sl1_5, tp1_5] = request.security(sym1, "5", f_retestSignal(), barmerge.gaps_off, barmerge.lookahead_off)
[s1_15, e1_15, sl1_15, tp1_15] = request.security(sym1, "15", f_retestSignal(), barmerge.gaps_off, barmerge.lookahead_off)
[s1_30, e1_30, sl1_30, tp1_30] = request.security(sym1, "30", f_retestSignal(), barmerge.gaps_off, barmerge.lookahead_off)
[s1_60, e1_60, sl1_60, tp1_60] = request.security(sym1, "60", f_retestSignal(), barmerge.gaps_off, barmerge.lookahead_off)
[s1_240, e1_240, sl1_240, tp1_240] = request.security(sym1, "240", f_retestSignal(), barmerge.gaps_off, barmerge.lookahead_off)
[s1_D, e1_D, sl1_D, tp1_D] = request.security(sym1, "D", f_retestSignal(), barmerge.gaps_off, barmerge.lookahead_off)

[s2_5, e2_5, sl2_5, tp2_5] = request.security(sym2, "5", f_retestSignal(), barmerge.gaps_off, barmerge.lookahead_off)
