    [fired6, newL6, msg6] = f_take(en1, enTfD, s1_D, e1_D, sl1_D, tp1_D, sym1, "D", last_s1_D)
    last_s1_D := newL6
    anyRetest := anyRetest or fired6
    if str.length(msg6) > 0
