//@version=6
// OB 5-Star Scanner - scan-only helper aligned with local ob-scanner Kasper-style scoring.
// Not financial advice. TV data may differ from the local Coinbase/Yahoo scanner.
indicator("OB 5-Star Scanner", overlay = true, max_boxes_count = 100, max_lines_count = 200, max_labels_count = 50)

minStars      = input.int(4, "Min stars", minval = 0, maxval = 5)
bodyLookback  = input.int(20, "Body lookback", minval = 5)
bodyMult      = input.float(1.5, "Body mult", minval = 0.5, step = 0.1)
breakLookback = input.int(10, "Break lookback", minval = 3)
obWalkback    = input.int(8, "OB walkback", minval = 1, maxval = 20)
bosLookback   = input.int(20, "BOS lookback", minval = 5)
showMitigated = input.bool(false, "Show mitigated")
extendRight   = input.bool(true, "Extend boxes right")
maxActive     = input.int(20, "Max active boxes to keep", minval = 1, maxval = 100)
bullColor     = input.color(color.new(#26a69a, 75), "Bull color")
bearColor     = input.color(color.new(#ef5350, 75), "Bear color")
showMid       = input.bool(true, "Show mid 50% line")
showSlTp      = input.bool(true, "Show Entry / SL / TP lines")
showLabels    = input.bool(true, "Show star labels on OB")
enableAlerts  = input.bool(true, "Fire alert() on new OB / retest")

type ObZone
    int obBar
    int dispBar
    int side
    float hi
    float lo
    float mid
    float entry
    float sl
    float tp
    float r
    int stars
    bool fvg
    bool bos
    bool sweep
    bool fresh
    bool pd
    bool mitigated
    bool alertedRetest
    box bx = na
    line midLn = na
    line slLn = na
    line tpLn = na
    label lbl = na

var array<ObZone> obs = array.new<ObZone>()

var bool newBullOb = false
var bool newBearOb = false
var bool retestBull = false
var bool retestBear = false

newBullOb := false
newBearOb := false
retestBull := false
retestBear := false

f_body(int off) =>
    math.abs(close[off] - open[off])

f_flagsText(ObZone o) =>
    (o.fvg ? "FVG " : "") + (o.bos ? "BOS " : "") + (o.sweep ? "SWP " : "") + (o.fresh ? "FR " : "") + (o.pd ? "PD" : "")

f_starsText(int n) =>
    str.tostring(n) + "*"

// Entry = mid; SL beyond OB extreme + buffer; TP = 1.5R
f_slTp(float hi, float lo, int side) =>
    float entry = (hi + lo) / 2.0
    float rng = math.max(0.0, hi - lo)
    float buf = math.max(rng * 0.05, syminfo.mintick * 2.0)
    float sl = side == 1 ? lo - buf : hi + buf
    float r = math.abs(entry - sl)
    float tp = side == 1 ? entry + 1.5 * r : entry - 1.5 * r
    [entry, sl, tp, r]

f_slTpText(ObZone o) =>
    "E=" + str.tostring(o.entry, format.mintick) + " SL=" + str.tostring(o.sl, format.mintick) + " TP=" + str.tostring(o.tp, format.mintick) + " RR=1.5"

f_deleteVisuals(ObZone o) =>
    if not na(o.bx)
        box.delete(o.bx)
    if not na(o.midLn)
        line.delete(o.midLn)
    if not na(o.slLn)
        line.delete(o.slLn)
    if not na(o.tpLn)
        line.delete(o.tpLn)
    if not na(o.lbl)
        label.delete(o.lbl)
    true

f_styleMitigated(ObZone o) =>
    grayFill = color.new(color.gray, 88)
    grayBord = color.new(color.gray, 50)
    if not na(o.bx)
        box.set_bgcolor(o.bx, grayFill)
        box.set_border_color(o.bx, grayBord)
        box.set_border_style(o.bx, line.style_dashed)
    if not na(o.midLn)
        line.set_color(o.midLn, color.new(color.gray, 40))
        line.set_style(o.midLn, line.style_dashed)
    if not na(o.slLn)
        line.set_color(o.slLn, color.new(color.gray, 50))
    if not na(o.tpLn)
        line.set_color(o.tpLn, color.new(color.gray, 50))
    if not na(o.lbl)
        label.set_text(o.lbl, f_starsText(o.stars) + " mit")
        label.set_color(o.lbl, color.new(color.gray, 30))
        label.set_textcolor(o.lbl, color.white)
    true

f_hideOrStyleMitigated(ObZone o) =>
    if showMitigated
        f_styleMitigated(o)
        true
    else
        f_deleteVisuals(o)
        o.bx := na
        o.midLn := na
        o.slLn := na
        o.tpLn := na
        o.lbl := na
        true

f_capObs() =>
    while array.size(obs) > maxActive
        oldest = array.shift(obs)
        f_deleteVisuals(oldest)
    true

f_existsDedup(int obBar, int side) =>
    bool found = false
    sz = array.size(obs)
    if sz > 0
        for i = 0 to sz - 1
            o = array.get(obs, i)
            if o.obBar == obBar and o.side == side
                found := true
                break
    found

f_scoreFvg(int dOff, bool bullish) =>
    bool hit = false
    if dOff >= 1
        if bullish and low[dOff - 1] > high[dOff + 1]
            hit := true
        if not bullish and high[dOff - 1] < low[dOff + 1]
            hit := true
    if not hit and bar_index >= dOff + 2
        if bullish and low[dOff] > high[dOff + 2]
            hit := true
        if not bullish and high[dOff] < low[dOff + 2]
            hit := true
    if not hit and dOff >= 2
        if bullish and low[dOff - 2] > high[dOff]
            hit := true
        if not bullish and high[dOff - 2] < low[dOff]
            hit := true
    if not hit
        for a = 1 to 3
            ao = dOff - a
            if ao >= 0
                if bullish and low[ao] > high[dOff]
                    hit := true
                if not bullish and high[ao] < low[dOff]
                    hit := true
    hit

f_scoreBos(int dOff, bool bullish) =>
    float ph = ta.highest(high[dOff + 1], bosLookback)
    float pl = ta.lowest(low[dOff + 1], bosLookback)
    bullish ? close[dOff] > ph : close[dOff] < pl

f_scoreSweep(int dOff, bool bullish) =>
    bool ok = false
    if bar_index - dOff >= 15
        if bullish
            float raidLow = ta.lowest(low[dOff], 6)
            float priorLow = ta.lowest(low[dOff + 6], 10)
            ok := raidLow < priorLow
        else
            float raidHigh = ta.highest(high[dOff], 6)
            float priorHigh = ta.highest(high[dOff + 6], 10)
            ok := raidHigh > priorHigh
    ok

f_scorePd(int dOff, int obOff, float midPx, bool bullish) =>
    float swingLow = ta.lowest(low[dOff + 1], 50)
    int endOff = math.max(0, dOff - 5)
    int len = obOff - endOff + 1
    bool pass = false
    if len > 0
        float swingHigh = ta.highest(high[endOff], len)
        if not na(swingHigh) and swingHigh > swingLow
            float half = swingLow + 0.5 * (swingHigh - swingLow)
            pass := bullish ? midPx <= half : midPx >= half
    pass

f_makeVisuals(ObZone o) =>
    color fillC = o.side == 1 ? bullColor : bearColor
    color bordC = o.side == 1 ? color.new(#26a69a, 20) : color.new(#ef5350, 20)
    extMode = extendRight ? extend.right : extend.none
    o.bx := box.new(o.obBar, o.hi, o.dispBar, o.lo, xloc = xloc.bar_index, border_color = bordC, bgcolor = fillC, border_width = 1, extend = extMode)
    if showMid or showSlTp
        o.midLn := line.new(o.obBar, o.entry, o.dispBar, o.entry, xloc = xloc.bar_index, extend = extMode, color = color.new(#f0b429, 20), style = line.style_dashed, width = 1)
    if showSlTp
        o.slLn := line.new(o.obBar, o.sl, o.dispBar, o.sl, xloc = xloc.bar_index, extend = extMode, color = color.new(#ff8a65, 10), style = line.style_dotted, width = 1)
        o.tpLn := line.new(o.obBar, o.tp, o.dispBar, o.tp, xloc = xloc.bar_index, extend = extMode, color = color.new(#66bb6a, 10), style = line.style_dotted, width = 1)
    if showLabels
        string fl = f_flagsText(o)
        string txt = f_starsText(o.stars) + (str.length(fl) > 0 ? "\n" + fl : "") + "\n" + f_slTpText(o)
        o.lbl := label.new(o.obBar, o.side == 1 ? o.lo : o.hi, txt, xloc = xloc.bar_index, yloc = yloc.price, style = o.side == 1 ? label.style_label_up : label.style_label_down, color = o.side == 1 ? color.new(#26a69a, 20) : color.new(#ef5350, 20), textcolor = color.white, size = size.tiny)
    true

if barstate.isconfirmed and array.size(obs) > 0
    for i = 0 to array.size(obs) - 1
        ObZone o = array.get(obs, i)
        if not o.mitigated
            if o.side == 1 and close < o.mid
                o.mitigated := true
                o.fresh := false
                o.stars := math.max(0, o.stars - 1)
                f_hideOrStyleMitigated(o)
            else if o.side == -1 and close > o.mid
                o.mitigated := true
                o.fresh := false
                o.stars := math.max(0, o.stars - 1)
                f_hideOrStyleMitigated(o)
        if not o.mitigated and o.fresh and o.stars >= minStars and not o.alertedRetest
            if low <= o.hi and high >= o.lo and bar_index > o.dispBar
                o.alertedRetest := true
                if o.side == 1
                    retestBull := true
                else
                    retestBear := true
                if enableAlerts
                    alert("Retest " + (o.side == 1 ? "Bull" : "Bear") + " OB " + f_starsText(o.stars) + " " + syminfo.ticker + " " + timeframe.period + " mid=" + str.tostring(o.mid, format.mintick) + " " + f_slTpText(o) + " [" + f_flagsText(o) + "]", alert.freq_once_per_bar_close)

bool enoughHistory = bar_index >= bodyLookback + breakLookback + obWalkback + 55

if barstate.isconfirmed and enoughHistory
    float bodyDisp = f_body(1)
    float sumB = 0.0
    for j = 2 to bodyLookback + 1
        sumB += f_body(j)
    float avgBody = sumB / bodyLookback

    bool strongBody = avgBody > 0 and bodyDisp >= bodyMult * avgBody
    float priorHigh = ta.highest(high[2], breakLookback)
    float priorLow = ta.lowest(low[2], breakLookback)

    bool bullDisp = close[1] > open[1] and (strongBody or close[1] > priorHigh)
    bool bearDisp = close[1] < open[1] and (strongBody or close[1] < priorLow)

    if bullDisp or bearDisp
        bool isBull = bullDisp
        int obOff = na
        int walkEnd = 1 + obWalkback
        for k = 2 to walkEnd
            if isBull
                if close[k] < open[k]
                    obOff := k
                    break
            else
                if close[k] > open[k]
                    obOff := k
                    break

        if not na(obOff)
            int obBarIdx = bar_index - obOff
            int dispBarIdx = bar_index - 1
            int side = isBull ? 1 : -1

            if not f_existsDedup(obBarIdx, side)
                float obHi = high[obOff]
                float obLo = low[obOff]
                float obMid = (obHi + obLo) / 2.0
                [obEntry, obSl, obTp, obR] = f_slTp(obHi, obLo, side)

                bool flFvg = f_scoreFvg(1, isBull)
                bool flBos = f_scoreBos(1, isBull)
                bool flSweep = f_scoreSweep(1, isBull)
                bool flFresh = true
                bool flPd = f_scorePd(1, obOff, obMid, isBull)

                int stars = (flFvg ? 1 : 0) + (flBos ? 1 : 0) + (flSweep ? 1 : 0) + (flFresh ? 1 : 0) + (flPd ? 1 : 0)

                if stars >= minStars
                    ObZone o = ObZone.new(obBarIdx, dispBarIdx, side, obHi, obLo, obMid, obEntry, obSl, obTp, obR, stars, flFvg, flBos, flSweep, flFresh, flPd, false, false, na, na, na, na, na)
                    f_makeVisuals(o)
                    array.push(obs, o)
                    f_capObs()

                    if isBull
                        newBullOb := true
                    else
                        newBearOb := true

                    if enableAlerts
                        alert((isBull ? "Bull" : "Bear") + " OB " + f_starsText(stars) + " " + syminfo.ticker + " " + timeframe.period + " mid=" + str.tostring(obMid, format.mintick) + " zone=" + str.tostring(obLo, format.mintick) + "-" + str.tostring(obHi, format.mintick) + " " + f_slTpText(o) + " [" + f_flagsText(o) + "]", alert.freq_once_per_bar_close)

alertcondition(newBullOb, title = "OB 5-Star Bull", message = "Bullish OB >= Min stars")
alertcondition(newBearOb, title = "OB 5-Star Bear", message = "Bearish OB >= Min stars")
alertcondition(retestBull, title = "Retest Bull OB", message = "Retest of fresh bullish OB >= Min stars")
alertcondition(retestBear, title = "Retest Bear OB", message = "Retest of fresh bearish OB >= Min stars")
